{
  "name": "klod-site",
  "main": "worker/index.js",
  "routes": [
    { "pattern": "aj-propertymaintenance.co.uk", "custom_domain": true },
    { "pattern": "www.aj-propertymaintenance.co.uk", "custom_domain": true }
  ],
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash"
  },
  // LIVE: enquiries go to Klod, sent with his Resend key (onboarding@resend.dev only delivers to that account's owner).
  "vars": {
    "NOTIFY_TO": "klontian12@gmail.com",
    "RESEND_FROM": "A&J Property Maintenance Solutions <onboarding@resend.dev>",
    "DRY_RUN": "0"
  },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "2701", "simple": { "limit": 30, "period": 60 } },
    { "name": "LEAD_LIMIT", "namespace_id": "2703", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
